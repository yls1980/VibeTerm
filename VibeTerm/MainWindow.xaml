<Window x:Class="VibeTerm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VibeTerm"
        Width="1200" Height="750"
        MinWidth="640" MinHeight="400"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="T"   Modifiers="Ctrl+Shift" Command="{Binding AddTerminalCommand}"/>
        <KeyBinding Key="W"   Modifiers="Ctrl"       Command="{Binding CloseTerminalCommand}"/>
        <KeyBinding Key="Tab" Modifiers="Ctrl"        Command="{Binding NextTerminalCommand}"/>
        <KeyBinding Key="Tab" Modifiers="Ctrl+Shift"  Command="{Binding PrevTerminalCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <!-- ══ Centre: terminal area ══════════════════════════════════════════ -->
        <Grid Grid.Column="0">
            <Grid x:Name="TerminalArea" Background="{StaticResource BackgroundBrush}"/>

            <!-- Shown when no terminals are open -->
            <Border x:Name="NoTerminalOverlay" Background="{StaticResource BackgroundBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="VibeTerm"
                               FontSize="32" FontFamily="Cascadia Mono, Consolas"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Press Ctrl+Shift+T or click  +  to open a terminal"
                               FontFamily="Consolas" FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══ Right: sidebar ═════════════════════════════════════════════════ -->
        <Border Grid.Column="1"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,10">
                    <Grid>
                        <TextBlock Text="TERMINALS"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Content="+"
                                HorizontalAlignment="Right"
                                Command="{Binding AddTerminalCommand}"
                                Style="{StaticResource AddButtonStyle}"
                                ToolTip="New terminal (Ctrl+Shift+T)"/>
                    </Grid>
                </Border>

                <!-- Terminal list -->
                <ListBox x:Name="TerminalList"
                         Grid.Row="1"
                         ItemsSource="{Binding Terminals}"
                         SelectedItem="{Binding SelectedTerminal, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="TerminalList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding"  Value="0"/>
                            <Setter Property="Margin"   Value="4,2"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Background="Transparent"
                                                Padding="8,6"
                                                CornerRadius="4"
                                                Cursor="Hand">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background"
                                                        Value="{StaticResource HoverItemBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background"
                                                        Value="{StaticResource ActiveItemBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Normal display (IsEditing = false) -->
                                <Grid Grid.Row="0"
                                      Visibility="{Binding IsEditing,
                                                   Converter={StaticResource BoolToInverseVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Status dot -->
                                    <Ellipse Grid.Column="0"
                                             Width="7" Height="7"
                                             Margin="0,0,6,0"
                                             VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{Binding StatusColor}"/>
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <!-- Name -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayName}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontFamily="Consolas" FontSize="12"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Rename button -->
                                    <Button Grid.Column="2"
                                            Content="✎"
                                            Width="18" Height="18"
                                            FontSize="11"
                                            Margin="4,0,0,0"
                                            Style="{StaticResource IconButtonStyle}"
                                            Command="{Binding BeginRenameCommand}"
                                            ToolTip="Rename"/>

                                    <!-- Close button -->
                                    <Button Grid.Column="3"
                                            Content="✕"
                                            Width="18" Height="18"
                                            FontSize="10"
                                            Margin="2,0,0,0"
                                            Style="{StaticResource IconButtonStyle}"
                                            Click="CloseTerminalButton_Click"
                                            Tag="{Binding}"
                                            ToolTip="Close terminal"/>
                                </Grid>

                                <!-- Rename editor (IsEditing = true) -->
                                <Grid Grid.Row="0"
                                      Visibility="{Binding IsEditing,
                                                   Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"
                                             x:Name="RenameBox"
                                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                             Background="{StaticResource BackgroundBrush}"
                                             Foreground="{StaticResource TextBrush}"
                                             BorderBrush="{StaticResource AccentBrush}"
                                             FontFamily="Consolas" FontSize="12"
                                             Padding="3,2"
                                             KeyDown="RenameBox_KeyDown"/>

                                    <Button Grid.Column="1" Content="✓"
                                            Width="22" Margin="3,0,0,0"
                                            Style="{StaticResource IconButtonStyle}"
                                            Command="{Binding CommitRenameCommand}"
                                            ToolTip="Confirm"/>

                                    <Button Grid.Column="2" Content="✕"
                                            Width="22" Margin="2,0,0,0"
                                            Style="{StaticResource IconButtonStyle}"
                                            Command="{Binding CancelRenameCommand}"
                                            ToolTip="Cancel"/>
                                </Grid>

                                <!-- Status label -->
                                <TextBlock Grid.Row="1"
                                           Text="{Binding StatusText}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="10" Margin="13,2,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Environment variables -->
                <Expander x:Name="EnvironmentExpander"
                          Grid.Row="2"
                          Header="ENVIRONMENT"
                          IsExpanded="True"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="0,1,0,0"
                          Foreground="{StaticResource TextMutedBrush}"
                          Background="{StaticResource SidebarBrush}"
                          FontFamily="Consolas"
                          FontSize="11"
                          Padding="8,6">
                    <Grid Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="150"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DataGrid x:Name="EnvironmentGrid"
                                  Grid.Row="0"
                                  ItemsSource="{Binding EnvironmentVariables}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  Background="{StaticResource BackgroundBrush}"
                                  Foreground="{StaticResource TextBrush}"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  BorderThickness="1"
                                  RowBackground="{StaticResource BackgroundBrush}"
                                  AlternatingRowBackground="{StaticResource SidebarBrush}"
                                  HorizontalGridLinesBrush="{StaticResource BorderBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name"
                                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Value"
                                                    Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="+"
                                    Width="28" Height="24"
                                    Command="{Binding AddEnvironmentVariableCommand}"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTip="Add environment variable"/>
                            <Button Grid.Column="1"
                                    Content="✕"
                                    Width="28" Height="24"
                                    Margin="4,0,0,0"
                                    Command="{Binding RemoveEnvironmentVariableCommand}"
                                    CommandParameter="{Binding SelectedItem, ElementName=EnvironmentGrid}"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTip="Remove selected variable"/>
                            <Button Grid.Column="2"
                                    Content="Apply"
                                    HorizontalAlignment="Right"
                                    MinWidth="64" Height="24"
                                    Command="{Binding ApplyEnvironmentVariablesCommand}"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTip="Apply to all open terminals"/>
                        </Grid>
                    </Grid>
                </Expander>

                <!-- Footer: font controls + settings -->
                <Border Grid.Row="3"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="8,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,6">
                            <Button Content="A⁻" Width="28" Height="24"
                                    Click="FontDecrease_Click"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTip="Decrease font (Ctrl+-)"/>
                            <TextBlock x:Name="FontSizeLabel"
                                       Text="14" Width="28"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11"/>
                            <Button Content="A⁺" Width="28" Height="24"
                                    Click="FontIncrease_Click"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTip="Increase font (Ctrl++)"/>
                            <Button Content="A" Width="28" Height="24" Margin="4,0,0,0"
                                    Click="FontReset_Click"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTip="Reset font (Ctrl+0)"/>
                        </StackPanel>
                        <Button Content="⚙  Settings"
                                HorizontalAlignment="Stretch"
                                Command="{Binding OpenSettingsCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                Foreground="{StaticResource TextMutedBrush}"
                                FontSize="12" Padding="8,4"/>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>
