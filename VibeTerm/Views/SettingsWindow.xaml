<Window x:Class="VibeTerm.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings — VibeTerm"
        Width="520" Height="640"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="0">
            <StackPanel>

                <!-- Shell -->
                <TextBlock Text="Shell" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Shell path:" VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}" Margin="0,0,12,0"/>
                    <TextBox x:Name="ShellPathBox" Grid.Column="1"
                             Background="{StaticResource BackgroundBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             Padding="6,4" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="Browse" Margin="8,0,0,0"
                            Click="BrowseShell_Click"
                            Style="{StaticResource IconButtonStyle}"
                            Padding="8,4"/>
                </Grid>
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Startup directory:" VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}" Margin="0,0,12,0"/>
                    <TextBox x:Name="StartupDirBox" Grid.Column="1"
                             Background="{StaticResource BackgroundBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             Padding="6,4" VerticalAlignment="Center"/>
                </Grid>

                <!-- Font -->
                <TextBlock Text="Font" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Font family:" VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}" Margin="0,0,12,0"/>
                    <TextBox x:Name="FontFamilyBox" Grid.Column="1"
                             Background="{StaticResource BackgroundBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             Padding="6,4"/>
                </Grid>
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Font size:" VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}" Margin="0,0,12,0"/>
                    <Slider x:Name="FontSizeSlider" Grid.Column="1"
                            Minimum="8" Maximum="32" TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Foreground="{StaticResource AccentBrush}"/>
                </Grid>

                <!-- Logging -->
                <TextBlock Text="Logging" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
                <CheckBox x:Name="EnableLoggingCheck" Content="Enable session logging"
                          Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                <CheckBox x:Name="MaskSensitiveCheck" Content="Mask sensitive data in logs (API keys, passwords, tokens)"
                          Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                <TextBlock Text="⚠ Terminal logs may contain sensitive data. Review logs before sharing."
                           Foreground="{StaticResource WarningBrush}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Log directory:" VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}" Margin="0,0,12,0"/>
                    <TextBox x:Name="LogDirBox" Grid.Column="1"
                             Background="{StaticResource BackgroundBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             Padding="6,4"/>
                    <Button Grid.Column="2" Content="Open" Margin="8,0,0,0"
                            Click="OpenLogDir_Click"
                            Style="{StaticResource IconButtonStyle}"
                            Padding="8,4"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Retain logs (days):" VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}" Margin="0,0,12,0"/>
                    <TextBox x:Name="RetentionDaysBox" Grid.Column="1" Width="60"
                             Background="{StaticResource BackgroundBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             Padding="6,4"/>
                </Grid>

                <TextBlock Text="Panel API" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" Margin="0,16,0,8"/>
                <CheckBox x:Name="EnablePanelApiCheck" Content="Enable local panel API for MCP"
                          Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                <TextBlock Text="Applies on the next start. The API listens on 127.0.0.1 and can type into terminal panels."
                           Foreground="{StaticResource WarningBrush}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0"
                    Click="Cancel_Click"
                    Style="{StaticResource IconButtonStyle}"
                    Padding="8,6"
                    Foreground="{StaticResource TextBrush}"/>
            <Button Content="Save" Width="80"
                    Click="Save_Click"
                    Background="{StaticResource AccentBrush}"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="8,6"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
