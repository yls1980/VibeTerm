<Application x:Class="VibeTerm.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:VibeTerm.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ── Converters ──────────────────────────────────────────────── -->
            <conv:BoolToVisibilityConverter        x:Key="BoolToVisibilityConverter"/>
            <conv:BoolToInverseVisibilityConverter x:Key="BoolToInverseVisibilityConverter"/>

            <!-- ── Dark theme palette ─────────────────────────────────────── -->
            <Color x:Key="BackgroundColor">#1E1E1E</Color>
            <Color x:Key="SurfaceColor">#252526</Color>
            <Color x:Key="SidebarColor">#2D2D30</Color>
            <Color x:Key="BorderColor">#3F3F46</Color>
            <Color x:Key="AccentColor">#007ACC</Color>
            <Color x:Key="TextColor">#D4D4D4</Color>
            <Color x:Key="TextMutedColor">#858585</Color>
            <Color x:Key="ActiveItemColor">#094771</Color>
            <Color x:Key="HoverItemColor">#2A2D2E</Color>
            <Color x:Key="DangerColor">#F44747</Color>
            <Color x:Key="SuccessColor">#6A9955</Color>
            <Color x:Key="WarningColor">#DCDCAA</Color>

            <SolidColorBrush x:Key="BackgroundBrush"  Color="{StaticResource BackgroundColor}"/>
            <SolidColorBrush x:Key="SurfaceBrush"     Color="{StaticResource SurfaceColor}"/>
            <SolidColorBrush x:Key="SidebarBrush"     Color="{StaticResource SidebarColor}"/>
            <SolidColorBrush x:Key="BorderBrush"      Color="{StaticResource BorderColor}"/>
            <SolidColorBrush x:Key="AccentBrush"      Color="{StaticResource AccentColor}"/>
            <SolidColorBrush x:Key="TextBrush"        Color="{StaticResource TextColor}"/>
            <SolidColorBrush x:Key="TextMutedBrush"   Color="{StaticResource TextMutedColor}"/>
            <SolidColorBrush x:Key="ActiveItemBrush"  Color="{StaticResource ActiveItemColor}"/>
            <SolidColorBrush x:Key="HoverItemBrush"   Color="{StaticResource HoverItemColor}"/>
            <SolidColorBrush x:Key="DangerBrush"      Color="{StaticResource DangerColor}"/>
            <SolidColorBrush x:Key="SuccessBrush"     Color="{StaticResource SuccessColor}"/>
            <SolidColorBrush x:Key="WarningBrush"     Color="{StaticResource WarningColor}"/>

            <!-- ── Button base style ──────────────────────────────────────── -->
            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Background"   Value="Transparent"/>
                <Setter Property="Foreground"   Value="{StaticResource TextMutedBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding"      Value="4"/>
                <Setter Property="Cursor"       Value="Hand"/>
                <Setter Property="FontSize"     Value="12"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverItemBrush}"/>
                                    <Setter Property="Foreground"  Value="{StaticResource TextBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource ActiveItemBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── Add-terminal (+) button ────────────────────────────────── -->
            <Style x:Key="AddButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource IconButtonStyle}">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="FontSize"   Value="18"/>
                <Setter Property="Width"      Value="28"/>
                <Setter Property="Height"     Value="28"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
